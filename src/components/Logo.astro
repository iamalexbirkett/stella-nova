---
import Mark from './Mark.astro';
interface Props { tone?: 'light' | 'dark' }
const { tone = 'light' } = Astro.props;
---
<a href="/" class:list={['logo', `logo--${tone}`]} aria-label="Stella Nova, home">
  <Mark size={30} class="logo__mark" />
  <span class="logo__word">Stella Nova</span>
</a>
<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--schott-black);
  }
  .logo--dark { color: var(--bone-paper); }
  .logo__mark { color: var(--monk-red); transition: transform 600ms cubic-bezier(.2,.7,.2,1); }
  .logo:hover .logo__mark { transform: rotate(45deg); }
  .logo:hover { color: inherit; }
  .logo--dark .logo__mark { color: var(--bone-paper); }
  .logo__word {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  @media (prefers-reduced-motion: reduce) { .logo__mark { transition: none; } }
</style>
