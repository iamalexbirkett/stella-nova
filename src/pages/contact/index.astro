---
import Base from '../../layouts/Base.astro';
import Mark from '../../components/Mark.astro';
import { offers, site } from '../../data/site';

const interests = [
  ...offers.map((o) => ({ value: o.slug, label: o.name })),
  { value: 'speaking', label: 'Speaking or a podcast' },
  { value: 'unsure', label: 'Not sure yet' },
];
---
<Base title="Talk to me" description="Tell Alex what's going on. Every message is read and answered personally.">
  <section class="contact">
    <div class="wrap contact__grid">
      <div class="contact__intro">
        <p class="eyebrow">Talk to me</p>
        <h1>Tell me what’s actually going on.</h1>
        <p class="lede muted">
          The market, the team, the number you’re worried about. I read every message myself and reply personally. No
          sales team, no drip sequence.
        </p>
        <ul class="contact__notes">
          <li>Investors: tell me roughly how many portfolio companies you’re thinking about.</li>
          <li>Brands: tell me who you keep losing to in AI answers.</li>
          <li>Everyone: tell me the part you’d leave out of the pitch.</li>
        </ul>
        <Mark size={64} class="contact__mark" />
      </div>

      <form class="form" method="post" action="https://api.web3forms.com/submit" data-contact-form>
        <input type="hidden" name="access_key" value={site.formKey} />
        <input type="hidden" name="subject" value="Stella Nova inquiry" />
        <input type="hidden" name="from_name" value="stellanovainc.com" />
        <input type="hidden" name="redirect" value={`${site.url}/contact/thanks`} />
        <div class="form__row form__row--2">
          <label>
            <span>Name</span>
            <input name="name" type="text" autocomplete="name" required maxlength="120" />
          </label>
          <label>
            <span>Work email</span>
            <input name="email" type="email" autocomplete="email" required maxlength="200" />
          </label>
        </div>
        <div class="form__row form__row--2">
          <label>
            <span>Company or firm</span>
            <input name="company" type="text" autocomplete="organization" maxlength="160" />
          </label>
          <label>
            <span>I’m with</span>
            <select name="role">
              <option value="">Choose one</option>
              <option>A VC or PE firm</option>
              <option>A portfolio company</option>
              <option>A brand</option>
              <option>Something else</option>
            </select>
          </label>
        </div>
        <fieldset class="form__row">
          <legend>What are you interested in?</legend>
          <div class="chips">
            {interests.map((i) => (
              <label class="chip">
                <input type="checkbox" name="interest" value={i.value} />
                <span>{i.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <label class="form__row">
          <span>What’s going on?</span>
          <textarea name="message" rows="6" required maxlength="5000"></textarea>
        </label>
        <input type="checkbox" name="botcheck" class="form__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="form__actions">
          <button type="submit" class="btn btn--amber">Send it <span class="arrow" aria-hidden="true">→</span></button>
          <p class="form__status" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('.form__status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

    const preset = new URLSearchParams(location.search).get('interest');
    if (preset) {
      const box = form.querySelector<HTMLInputElement>(`input[name=interest][value="${CSS.escape(preset)}"]`);
      if (box) box.checked = true;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      if (!data.get('access_key')) {
        status.textContent = 'The form isn’t connected yet. Please try again shortly.';
        return;
      }
      // Checkboxes share a name; send them as one readable field.
      const payload: Record<string, string> = {};
      for (const [k, v] of data) {
        if (k === 'redirect' || k === 'botcheck') continue;
        payload[k] = k === 'interest' && payload[k] ? `${payload[k]}, ${v}` : String(v);
      }
      if (data.get('botcheck')) return;
      payload.replyto = payload.email;

      button.disabled = true;
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.success) throw new Error(json.message || 'Something went wrong. Please try again.');
        location.assign('/contact/thanks');
      } catch (err) {
        status.textContent = err instanceof Error ? err.message : 'Something went wrong. Please try again.';
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .contact { padding-block: clamp(3rem, 2rem + 5vw, 6rem); }
  .contact__grid { display: grid; grid-template-columns: 5fr 6fr; gap: clamp(2rem, 1rem + 5vw, 6rem); align-items: start; }
  .contact h1 { font-size: var(--step-4); }
  .contact__notes { margin: 2rem 0; display: grid; gap: 0.75rem; }
  .contact__notes li { padding-left: 1.5rem; position: relative; }
  .contact__notes li::before { content: ''; position: absolute; left: 0; top: 0.75em; width: 0.8rem; height: 1px; background: var(--monk-red); }
  :global(.contact__mark) { color: var(--monk-red); margin-top: 2rem; }

  .form { background: var(--schott-black); color: var(--bone-paper); padding: clamp(1.5rem, 1rem + 2.5vw, 3rem); display: grid; gap: 1.4rem; }
  .form__row { display: grid; gap: 0.4rem; border: 0; padding: 0; margin: 0; min-width: 0; }
  .form__row--2 { grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .form label > span, .form legend {
    display: block;
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cold-ash);
    margin-bottom: 0.4rem;
  }
  .form__row--2 label { display: grid; }
  .form input[type='text'], .form input[type='email'], .form select, .form textarea {
    width: 100%;
    font: inherit;
    color: var(--bone-paper);
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgb(237 230 217 / 0.35);
    padding: 0.55rem 0;
    border-radius: 0;
    transition: border-color 160ms ease;
  }
  .form textarea { border: 1px solid rgb(237 230 217 / 0.35); padding: 0.75rem; resize: vertical; }
  .form select option { color: var(--schott-black); }
  .form input:focus, .form select:focus, .form textarea:focus { outline: none; border-color: var(--amber-window); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { position: relative; cursor: pointer; }
  .chip input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .chip span {
    display: inline-block !important;
    margin: 0 !important;
    padding: 0.5rem 0.85rem;
    border: 1px solid rgb(237 230 217 / 0.35);
    border-radius: 999px;
    font-size: var(--step--1) !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
    font-weight: 500 !important;
    color: var(--bone-paper) !important;
    transition: background 160ms ease, border-color 160ms ease;
  }
  .chip input:checked + span { background: var(--bone-paper); color: var(--schott-black) !important; border-color: var(--bone-paper); }
  .chip input:focus-visible + span { outline: 2px solid var(--amber-window); outline-offset: 2px; }
  .form__hp { position: absolute; left: -9999px; opacity: 0; }
  .form__actions { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .form__status { margin: 0; font-size: var(--step--1); color: var(--amber-soft); }
  .form button[disabled] { opacity: 0.6; cursor: progress; }

  @media (max-width: 860px) {
    .contact__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .form__row--2 { grid-template-columns: 1fr; }
  }
</style>
